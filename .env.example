# Zerion AI Security - Production Environment Configuration Example
# Copy this file to .env and fill in your operational keys.

# ==============================================================================
# 1. FastAPI Backend Configuration
# ==============================================================================
PORT=7860
HOST=0.0.0.0
ZERION_API_KEY=zerion_secret_key_v2
JWT_SECRET=your_32_byte_secure_jwt_secret_here
JWT_ALGORITHM=HS256
DB_PATH=zerion_logs.db

# ==============================================================================
# 2. Production Deployment & API Gateway URLs
# ==============================================================================
PUBLIC_API_URL=https://zerion-ai-security.onrender.com
REACT_APP_API_URL=https://zerion-ai-security.onrender.com

# ==============================================================================
# 3. AI Engine Provider Keys
# ==============================================================================
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Get your Groq API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ==============================================================================
# 4. OSINT Threat Intelligence Provider Keys (Optional)
# ==============================================================================
# VirusTotal API Key: https://www.virustotal.com/
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Google Safe Browsing API Key: https://developers.google.com/safe-browsing
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_key_here

# AbuseIPDB API Key: https://www.abuseipdb.com/
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# URLScan.io API Key: https://urlscan.io/
URLSCAN_API_KEY=your_urlscan_api_key_here

# ==============================================================================
# 5. Rate Limiting Parameters (Token Bucket Algorithm)
# ==============================================================================
RATE_LIMIT_BURST=30
RATE_LIMIT_RATE=1.0
